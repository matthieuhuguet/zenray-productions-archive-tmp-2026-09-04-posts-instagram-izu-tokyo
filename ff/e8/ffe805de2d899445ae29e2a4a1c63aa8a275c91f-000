  .out-inner h3 { margin: 0 0 10px; font: 600 14px InterLocal, sans-serif; }
  .out-inner textarea {
    width: 100%; height: 320px; resize: vertical;
    background: #0d0e10; color: var(--accent); border: 1px solid rgba(255,255,255,.14);
    border-radius: 9px; padding: 10px 12px;
    font: 500 11px/1.5 ui-monospace, "AnthropicMono", monospace;
  }
  .out-inner .row { display: flex; gap: 8px; margin-top: 10px; }
</style>
