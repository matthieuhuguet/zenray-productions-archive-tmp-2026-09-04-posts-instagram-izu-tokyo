  :root {
    --bg: #101012;
    --panel: rgba(24,25,28,.96);
    --card: #1c1d20;
    --accent: #F38A5C;
    --text: rgba(255,255,255,.94);
    --muted: rgba(255,255,255,.52);
    --strip-height: 168px;
    --panel-gutter: 412px;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; height: 100%;
    background: var(--bg); color: var(--text);
    font: 400 13px/1.45 InterLocal, -apple-system, "Hiragino Sans W4", sans-serif;
    overflow: hidden;
  }

  header.top {
    position: fixed; top: 0; left: 0; right: var(--panel-gutter); z-index: 30;
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 12px 20px; background: var(--panel);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  header.top h1 {
    margin: 0; white-space: nowrap;
    font-family: AnthropicSerif, serif; font-size: 19px; font-weight: 400;
  }
  header.top .sub { color: var(--muted); font-size: 11.5px; white-space: nowrap; }
  .field { display: flex; align-items: center; gap: 6px; }
  .field label { color: var(--muted); font-size: 11.5px; }
  .field select {
    background: #0f0f11; color: var(--text); border: 1px solid rgba(255,255,255,.14);
    border-radius: 6px; padding: 4px 7px; font: inherit;
  }
  .spacer { flex: 1; }
  button.primary, button.ghost {
    border: none; border-radius: 8px; padding: 9px 15px;
    font: 600 12.5px InterLocal, sans-serif; cursor: pointer; white-space: nowrap;
  }
  button.primary { background: var(--accent); color: #17140f; }
  button.ghost { background: transparent; color: var(--accent); border: 1px solid rgba(243,138,92,.55); }
  button.primary:active, button.ghost:active { transform: translateY(1px); }

  .stage {
    position: fixed; top: 56px; left: 0; right: var(--panel-gutter); bottom: var(--strip-height);
    display: grid; place-items: center; padding: 18px; overflow: hidden;
    min-width: 0; min-height: 0;
  }
  /* Le cadre porte le RATIO de l'image et se borne au viewport ; le canvas le
     remplit. Un `max-width:100%` sur le canvas seul creait une circularite avec
     un parent inline-block dont la largeur venait du canvas : les deux tombaient
     a zero et l'image, pourtant bien chargee en texture, restait invisible. */
  .frame {
    position: relative; display: block; line-height: 0;
    container-type: inline-size;
    aspect-ratio: var(--img-ratio, 4 / 5);
    height: 100%; width: auto;
    max-width: 100%; max-height: 100%;
    border-radius: 10px; overflow: hidden;
    box-shadow: 0 18px 50px rgba(0,0,0,.5); background: #000;
  }
  .frame canvas { display: block; width: 100%; height: 100%; }
  #source { display: none; }

  #text-layers { position: absolute; inset: 0; pointer-events: none; }
  .text-layer {
    position: absolute; left: 0; right: 0; padding: 0 6%;
    line-height: 1.15; white-space: nowrap;
    text-shadow: 0 2px 10px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.65);
  }
  .text-layer.font-serif { font-family: AnthropicSerif, "Hiragino Mincho ProN W3", serif; }
  .text-layer.font-sans { font-family: InterLocal, "Hiragino Sans W4", sans-serif; }
  .text-layer.anchor-v-top { top: 6%; }
  .text-layer.anchor-v-middle { top: 50%; transform: translateY(-50%); }
  .text-layer.anchor-v-bottom { bottom: 6%; }
  .text-layer.anchor-h-left { text-align: left; }
  .text-layer.anchor-h-center { text-align: center; }
  .text-layer.anchor-h-right { text-align: right; }

  .strip {
    position: fixed; left: 0; right: var(--panel-gutter); bottom: 0; height: var(--strip-height);
    z-index: 30; display: flex; gap: 12px; align-items: flex-start;
    padding: 12px 20px; overflow-x: auto; overflow-y: hidden;
    background: var(--panel); border-top: 1px solid rgba(255,255,255,.08);
  }
  .tile {
    position: relative; flex: 0 0 auto; width: 104px;
    background: var(--card); border-radius: 10px; overflow: hidden;
    border: 2px solid transparent; cursor: grab; user-select: none;
    transition: opacity .12s, border-color .12s;
  }
  .tile.selected { border-color: var(--accent); }
  .tile.dragging { opacity: .3; }
  .tile.drop-target { border-color: #fff; }
  .tile .thumb { aspect-ratio: 4 / 5; overflow: hidden; background: #000; pointer-events: none; }
  .tile .thumb img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; }
  .tile .meta { display: flex; align-items: center; gap: 5px; padding: 5px 6px; pointer-events: none; }
  .tile .pos {
    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 5px;
    font: 700 11px ui-monospace, "AnthropicMono", monospace; flex: 0 0 auto;
  }
  .tile .nm {
    font: 500 9px ui-monospace, "AnthropicMono", monospace; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
  .tile .edited {
    position: absolute; top: 6px; right: 6px; width: 8px; height: 8px;
    border-radius: 50%; background: var(--accent); display: none;
    box-shadow: 0 0 0 2px rgba(0,0,0,.45);
  }
  .tile.has-edits .edited { display: block; }

  .zr-photo-panel { inset: 0 0 0 auto; width: var(--panel-gutter); max-height: 100vh; border-radius: 0; border-left: 1px solid rgba(255,255,255,.1); }
  .zr-photo-panel h2 { font-size: 19px; }
  .zr-photo-panel .current {
    margin: 0 0 10px; padding: 7px 9px; border-radius: 8px;
    background: rgba(255,255,255,.05);
    font: 500 11px ui-monospace, "AnthropicMono", monospace; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .zr-photo-panel .current b { color: var(--accent); }
  .apply-everything {
    width: 100%; min-height: 30px; margin-bottom: 12px;
    border: 1px solid rgba(243,138,92,.5); border-radius: 8px;
    background: transparent; color: var(--accent);
    font: 600 11px InterLocal, sans-serif; cursor: pointer;
  }
  .apply-everything.done { background: var(--accent); color: #17140f; }
  .variant-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin: -2px 0 10px; }
  .variant-action {
    display: inline-flex; min-height: 30px; align-items: center; justify-content: center; gap: 6px;
    border: 1px solid rgba(255,255,255,.18); border-radius: 8px; background: rgba(255,255,255,.04);
    color: var(--text); font: 600 11px InterLocal, sans-serif; cursor: pointer;
  }
  .variant-action:hover { border-color: rgba(243,138,92,.7); color: var(--accent); }
  .variant-action.danger:hover { border-color: rgba(238,112,112,.8); color: #ff9f9f; }
  .variant-action:disabled { opacity: .35; cursor: default; }
  .variant-action svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }

  /* Crans de pourcentage et propagation au lot */
  .control-block { margin-bottom: 9px; }
  .control-extra {
    display: flex; align-items: center; gap: 4px;
    margin: 3px 0 0 112px;
  }
  .control-extra .step {
    min-width: 22px; padding: 1px 5px; border-radius: 5px;
    border: 1px solid rgba(255,255,255,.14); background: #2f2f2f;
    color: var(--muted); font: 600 10px ui-monospace, monospace; cursor: pointer;
  }
  .control-extra .step.minor {
    min-width: 18px; padding: 0 4px; font-size: 8.5px; opacity: .62;
  }
  .control-extra .step:hover { color: var(--text); border-color: rgba(255,255,255,.3); }
  .apply-all {
    margin-left: auto; padding: 2px 8px; border-radius: 5px;
    border: 1px solid rgba(243,138,92,.45); background: transparent;
    color: var(--accent); font: 600 9.5px InterLocal, sans-serif; cursor: pointer;
    white-space: nowrap;
  }
  .apply-all.done { background: var(--accent); color: #17140f; }

  /* Calques de texte, jusqu'a trois par image */
  .layer-block {
    margin-bottom: 10px; padding: 9px; border-radius: 10px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07);
  }
  .layer-head {
    display: flex; align-items: center; gap: 7px; margin-bottom: 7px;
    font: 600 11px InterLocal, sans-serif; color: var(--muted);
  }
  .layer-head .idx {
    background: var(--accent); color: #17140f; border-radius: 4px; padding: 1px 6px;
    font: 700 10px ui-monospace, monospace;
  }
  .layer-head button {
    margin-left: auto; background: transparent; border: 1px solid rgba(255,255,255,.2);
    color: var(--muted); border-radius: 6px; padding: 3px 8px;
    font: 600 10.5px InterLocal, sans-serif; cursor: pointer;
  }
  .layer-block input[type=text] {
    width: 100%; margin-bottom: 7px; min-height: 32px; padding: 6px 8px;
    border: 0; border-radius: 8px; background: #3a3a3a; color: #fff;
    font: 12px InterLocal, sans-serif;
  }
  .layer-block .row2 { display: flex; gap: 7px; margin-bottom: 7px; }
  .layer-block .row2 select {
    flex: 1; min-width: 0; min-height: 30px; padding: 4px 7px;
    border: 0; border-radius: 7px; background: #3a3a3a; color: #fff;
    font: 11.5px InterLocal, sans-serif;
  }
  .layer-block .size-row { display: flex; align-items: center; gap: 7px; margin-bottom: 7px; }
  .layer-block .size-row input[type=number] {
    width: 78px; min-height: 30px; padding: 4px 7px; border: 0; border-radius: 7px;
    background: #3a3a3a; color: #fff; font: 11.5px InterLocal, sans-serif;
  }
  .layer-block .size-effective { font-size: 10px; color: var(--muted); }
  .layer-block .size-effective.adjusted { color: var(--accent); }
  .layer-block .bottom { display: flex; gap: 9px; align-items: flex-start; }
  .swatches { display: flex; gap: 6px; flex: 1; }
  .swatch {
    flex: 1; height: 26px; border-radius: 6px; cursor: pointer;
    border: 2px solid rgba(255,255,255,.14);
  }
  .swatch.active { border-color: var(--accent); }
  .swatch.yellow { background: #f6cf47; }
  .swatch.white { background: #ffffff; }
  .anchor-widget {
    display: grid; grid-template-columns: repeat(3, 17px); grid-template-rows: repeat(3, 17px);
    gap: 3px; flex: 0 0 auto;
  }
  .anchor-widget[data-mode="3"] { grid-template-columns: 17px; }
  .anchor-widget[data-mode="3"] button[data-anchor$="-left"],
  .anchor-widget[data-mode="3"] button[data-anchor$="-right"] { display: none; }
  .anchor-widget button {
    width: 17px; height: 17px; padding: 0; border-radius: 4px;
    border: 1px solid rgba(255,255,255,.16); background: #0f0f11; cursor: pointer;
  }
  .anchor-widget button.active { background: var(--accent); border-color: var(--accent); }
  #addLayerBtn {
    width: 100%; min-height: 34px; border: 1px dashed rgba(243,138,92,.6);
    border-radius: 9px; background: transparent; color: var(--accent);
    font: 600 12px InterLocal, sans-serif; cursor: pointer;
  }
  #addLayerBtn:disabled { opacity: .35; cursor: default; }

  .out-box { position: fixed; inset: 0; z-index: 60; display: none; place-items: center; background: rgba(0,0,0,.72); }
  .out-box.shown { display: grid; }
  .out-inner {
    width: min(760px, 90vw); background: #141517; border: 1px solid rgba(255,255,255,.12);
