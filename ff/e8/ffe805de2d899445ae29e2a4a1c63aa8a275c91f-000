      value: "", font: "serif", weight: 400,
      sizePx: DEFAULT_SIZE_PX, effectiveSizePx: DEFAULT_SIZE_PX,
      color: "#f6cf47", anchor: DEFAULT_ANCHOR_BY_INDEX[index] || "bottom-center"
    };
  }

  function isNeutralPhoto(values) {
    return JSON.stringify(values) === JSON.stringify(ZRPhotoAdjustments.defaults());
  }
  function isNeutralCrop(c) {
    return c.zoom === 1 && c.px === 50 && c.py === 50 && c.rotate === 0;
  }
  function hasEdits(id) {
    return !isNeutralPhoto(settings[id]) || !isNeutralCrop(crops[id]) ||
      layers[id].some(function (l) { return l.value.trim(); });
  }

  function srcUrl(file, id) {
    // L'apercu embarque est une data URI : same-origin, donc WebGL l'accepte
    // en file:// comme en http. Le chemin relatif ne sert que de repli, et il
    // ne fonctionne alors qu'a travers un service local.
    if (id && window.ZR_PREVIEWS && window.ZR_PREVIEWS[id]) return window.ZR_PREVIEWS[id];
    return SOURCE_DIR + encodeURIComponent(file).replace(/%2F/g, "/");
  }

  // Dimensions du FICHIER FINAL, jamais celles de l'apercu reduit : une taille
  // de texte annoncee en px doit valoir ces pixels-la sur le JPEG livre. Quand
  // un format cible est choisi, c'est lui qui commande ; en mode « source », ce
  // sont les dimensions de l'image d'origine.
  function outputSize() {
    var fmt = FORMATS[state.format];
    if (fmt) return { w: fmt.w * fmt.factor, h: fmt.h * fmt.factor };
    var img = byId[selectedId];
    if (img && img.w && img.h) return { w: img.w, h: img.h };
    return { w: canvas.width || 1080, h: canvas.height || 1350 };
  }

  // Taille de la toile d'APERCU : le format cible en unites de composition,
  // suffisant a l'ecran, et sans rapport avec la resolution livree.
  function previewSize() {
    var fmt = FORMATS[state.format];
    if (fmt) return { w: fmt.w, h: fmt.h };
    var img = byId[selectedId];
    return { w: Math.min(1400, img && img.w ? img.w : 1080),
             h: img && img.w ? Math.round(Math.min(1400, img.w) * img.h / img.w) : 1350 };
  }

  // Facteur anti-coin-transparent : agrandit la couverture pour qu'une rotation
  // ne laisse jamais voir le fond. Meme formule que le cook Python, a ne jamais
  // faire diverger.
  function safeScale(angleDeg, fw, fh) {
    var rad = angleDeg * Math.PI / 180;
    var ratio = Math.max(fh / fw, fw / fh);
    return Math.abs(Math.cos(rad)) + ratio * Math.abs(Math.sin(rad));
  }

  // CADRAGE : la source est dessinee dans une toile 2D a la taille du format,
  // avec zoom, position et rotation, et c'est CETTE toile qui devient la
  // texture du module photo. Le cadrage n'est donc plus une etape separee, mais
  // le premier maillon du meme pipeline : source -> crop 2D -> photo WebGL ->
  // texte. Le cook Python rejoue exactement la meme chaine.
  var cropCanvas = document.createElement("canvas");
  var cropCtx = cropCanvas.getContext("2d");

  function buildCrop() {
    if (!source.naturalWidth) return null;
    var p = previewSize();
    cropCanvas.width = p.w; cropCanvas.height = p.h;
    var nw = source.naturalWidth, nh = source.naturalHeight;
    var c = crops[selectedId];
    var s = Math.max(p.w / nw, p.h / nh);
    var x0 = (nw - p.w / s) * (c.px / 100);
    var y0 = (nh - p.h / s) * (c.py / 100);
    var k = s * c.zoom * safeScale(c.rotate, p.w, p.h) * 1.002;
    cropCtx.setTransform(1, 0, 0, 1, 0, 0);
    cropCtx.clearRect(0, 0, p.w, p.h);
    cropCtx.translate(p.w / 2, p.h / 2);
    cropCtx.rotate(c.rotate * Math.PI / 180);
    cropCtx.scale(k, k);
    cropCtx.translate(-(x0 + p.w / (2 * s)), -(y0 + p.h / (2 * s)));
    cropCtx.drawImage(source, 0, 0);
    return cropCanvas;
  }
  function canvasWidth() { return outputSize().w; }

  function isLandscape() { var s = outputSize(); return s.w > s.h; }

  function clampAnchorToCenter(anchor) { return anchor.split("-")[0] + "-center"; }

  function paint() {
    var cropped = buildCrop();
    if (cropped) processor.setImage(cropped);   // recadre, puis retouche
    processor.set(current());
    renderTextLayers();
    refreshTileFlags();
  }

  function scheduleRender() {
    // Le rendu ne doit JAMAIS pouvoir se bloquer : c'est l'outil d'edition de
    // Matthieu, un aperçu fige lui fait perdre tout controle. Or
    // requestAnimationFrame ne tire pas toujours (onglet en arriere-plan,
    // fenetre masquee, contexte sans compositeur). Sans filet, `framePending`
    // restait vrai pour toujours apres un rAF qui n'a jamais tire, et PLUS
    // AUCUN rendu n'avait lieu ensuite, curseurs comme texte.
    // Le filet en setTimeout garantit le rendu ; `done` garde la coalescence,
    // pour que le rAF et le repli ne peignent jamais deux fois.
    if (framePending) return;
    framePending = true;
    var done = false;
    var run = function () {
      if (done) return;
      done = true;
      framePending = false;
      paint();
    };
    requestAnimationFrame(run);
    setTimeout(run, 60);
  }

  // ---------- mesure du texte, jamais la boite DOM etiree ----------
  // Leçon deja payee cote picker light : mesurer le CONTENU (Canvas 2D), pas la
  // boite `left:0;right:0` qui vaut toujours la largeur du cadre. Meme algorithme
  // que ImageDraw.textbbox() cote Python.
  var measureContext = document.createElement("canvas").getContext("2d");

  function measureText(layer, fontSizePx) {
    var family = layer.font === "serif"
      ? '"AnthropicSerif", serif'
      : '"InterLocal", sans-serif';
    measureContext.font = layer.weight + " " + fontSizePx + "px " + family;
    var metrics = measureContext.measureText(layer.value);
    var width = metrics.actualBoundingBoxLeft !== undefined
      ? metrics.actualBoundingBoxLeft + metrics.actualBoundingBoxRight
      : metrics.width;
    var height = (metrics.actualBoundingBoxAscent || fontSizePx * 0.8) +
                 (metrics.actualBoundingBoxDescent || fontSizePx * 0.2);
    return { width: width, height: height };
  }

  // Auto-fit : la taille demandee est un POINT DE DEPART, jamais une valeur
  // imposee. On la reduit jusqu'a ce que le texte tienne entierement dans le
  // cadre (88 % de large, 88 % de haut), et c'est cette valeur reelle qui part
  // dans le presse-papier, jamais celle demandee.
  function fitSize(layer) {
    var out = outputSize();
    var cw = out.w, ch = out.h;
    var size = layer.sizePx;
    var maxW = cw * 0.88;
    var maxH = ch * 0.88;
    var guard = 0;
    var m = measureText(layer, size);
    while (guard++ < 200 && size > MIN_SIZE_PX && (m.width > maxW || m.height > maxH)) {
      size = Math.max(MIN_SIZE_PX, size - 2);
      m = measureText(layer, size);
    }
    return Math.round(size);
  }

  function renderTextLayers() {
    textLayersEl.innerHTML = "";
    var cw = canvasWidth();
    currentLayers().forEach(function (layer) {
      var effective = fitSize(layer);
      layer.effectiveSizePx = effective;
      if (!layer.value.trim()) return;
      var parts = layer.anchor.split("-");
      var el = document.createElement("div");
      el.className = "text-layer font-" + layer.font +
        " anchor-v-" + parts[0] + " anchor-h-" + parts[1];
      el.style.fontWeight = layer.weight;
      el.style.color = layer.color;
      el.style.fontSize = (effective / cw * 100) + "cqw";
      el.textContent = layer.value;
      textLayersEl.append(el);
    });
    refreshLayerReadouts();
  }

  // ---------- panneau photo ----------

  var controlRegistry = [];

  // Crans de pourcentage : 0, 25, 50, 75 et 100 pour cent de la PLAGE du
  // parametre, pas une valeur absolue. Un reglage qui va de -100 a 100 donne
  // donc -100, -50, 0, 50 et 100 : le cran du milieu est toujours le neutre,
  // quel que soit le parametre, ce qui rend les crans lisibles d'une ligne a
  // l'autre. Les crans 25 et 75 sont dessines plus petits que 0, 50 et 100,
  // qui sont les trois reperes principaux.
  var STEP_MARKS = [0, 25, 50, 75, 100];

  function steppedValue(min, max, percent) {
    return Number(min) + (Number(max) - Number(min)) * (percent / 100);
  }

  function slider(parent, label, path, min, max, value, step) {
    var block = document.createElement("div");
    block.className = "control-block";

    var row = document.createElement("label");
    row.className = "zr-photo-control";
    var name = document.createElement("span");
    name.textContent = label;
    var input = document.createElement("input");
    input.type = "range";
    input.min = min; input.max = max; input.step = step || 1; input.value = value;
    var output = document.createElement("output");
    output.value = Math.round(Number(value));

    function commit(v) {
      input.value = v;
      output.value = Math.round(Number(v));
      writePath(path, Number(v));
      scheduleRender();
    }

    input.addEventListener("input", function () { commit(Number(input.value)); });
    row.append(name, input, output);
    block.append(row);

    var extra = document.createElement("div");
    extra.className = "control-extra";
    STEP_MARKS.forEach(function (percent) {
      var mark = document.createElement("button");
      mark.type = "button";
      mark.className = "step" + (percent === 25 || percent === 75 ? " minor" : "");
      mark.textContent = percent;
      mark.title = percent + " % de la plage";
      mark.addEventListener("click", function () {
        commit(steppedValue(min, max, percent));
      });
      extra.append(mark);
    });

    // Propagation PONCTUELLE : la valeur est recopiee dans toutes les images au
    // moment du clic, et rien n'est lie ensuite. Chaque image reste modifiable
    // seule, sans que les autres bougent.
    var toAll = document.createElement("button");
    toAll.type = "button";
    toAll.className = "apply-all";
    toAll.textContent = "à toutes";
    toAll.title = "Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.";
    toAll.addEventListener("click", function () {
      applyPathToAll(path, Number(input.value));
      flash(toAll);
    });
    extra.append(toAll);

    block.append(extra);
    parent.append(block);
    controlRegistry.push({ input: input, output: output, path: path });
    return input;
  }

  function flash(button) {
    button.classList.add("done");
    setTimeout(function () { button.classList.remove("done"); }, 700);
  }

  // Ecrit une valeur au meme chemin dans TOUTES les images. Le chemin est
  // resolu une fois (le canal Selective Color courant vaut pour tout le lot),
  // puis chaque jeu de reglages recoit sa propre copie.
  function applyPathToAll(path, value) {
    order.forEach(function (id) { writePath(path, value, id); });
    refreshTileFlags();
  }

  // Copie INTEGRALE des reglages de l'image courante vers toutes les autres,
  // photo et calques de texte compris. Copie profonde, jamais une reference
  // partagee : modifier une image ensuite ne doit toucher qu'elle.
  function applyEverythingToAll() {
    var photo = JSON.parse(JSON.stringify(settings[selectedId]));
    var text = JSON.parse(JSON.stringify(layers[selectedId]));
    var crop = JSON.parse(JSON.stringify(crops[selectedId]));
    order.forEach(function (id) {
      if (id === selectedId) return;
      settings[id] = JSON.parse(JSON.stringify(photo));
      layers[id] = JSON.parse(JSON.stringify(text));
      crops[id] = JSON.parse(JSON.stringify(crop));
    });
    refreshTileFlags();
  }

  // `path` designe un chemin dans l'objet de reglages : "saturation",
  // "levels.midtone", ou "selective.ACTIVE.hue" (ACTIVE = canal courant).
  function resolvePath(path) {
    return path.replace("ACTIVE", String(selectedChannel)).split(".");
  }
  // Un chemin prefixe par `crop.` designe le CADRAGE, tout le reste designe les
  // reglages photo. C'est ce routage qui permet au cadrage d'etre un groupe de
  // reglages comme un autre, avec ses crans et sa propagation, sans dupliquer
  // une ligne de code d'interface.
  function rootFor(parts, id) {
    return parts[0] === "crop" ? crops[id || selectedId] : settings[id || selectedId];
  }
  function writePath(path, value, id) {
    var parts = resolvePath(path);
    var node = rootFor(parts, id);
    var start = parts[0] === "crop" ? 1 : 0;
    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];
    node[parts[parts.length - 1]] = value;
  }
  function readPath(path) {
    var parts = resolvePath(path);
    var node = rootFor(parts);
    var start = parts[0] === "crop" ? 1 : 0;
    for (var i = start; i < parts.length - 1; i++) node = node[parts[i]];
    return node[parts[parts.length - 1]];
  }

  function syncPhotoControls() {
    controlRegistry.forEach(function (control) {
      var value = readPath(control.path);
      control.input.value = value;
      control.output.value = Math.round(Number(value));
    });
    document.querySelectorAll("#filter-buttons button").forEach(function (button) {
      button.setAttribute("aria-pressed", button.dataset.filter === current().filter ? "true" : "false");
    });
  }

  function buildPhotoControls() {
    var crop = document.getElementById("crop-controls");
    slider(crop, "Zoom", "crop.zoom", 1, 3, 1, 0.01);
    slider(crop, "Position X", "crop.px", 0, 100, 50);
    slider(crop, "Position Y", "crop.py", 0, 100, 50);
    slider(crop, "Rotation °", "crop.rotate", -45, 45, 0, 0.5);

    slider(document.getElementById("vignette-controls"), "Strength", "vignette", 0, 100, 0);
    slider(document.getElementById("grain-controls"), "Strength", "grain", 0, 100, 0);

    var tabs = document.getElementById("selective-tabs");
    CHANNELS.forEach(function (name, index) {
      var button = document.createElement("button");
      button.type = "button";
      button.dataset.channel = index;
      button.title = name;
      button.setAttribute("aria-label", name);
      button.setAttribute("aria-pressed", index === selectedChannel ? "true" : "false");
      button.addEventListener("click", function () {
        selectedChannel = index;
        tabs.querySelectorAll("button").forEach(function (b) {
          b.setAttribute("aria-pressed", Number(b.dataset.channel) === index ? "true" : "false");
        });
        syncPhotoControls();
      });
      tabs.append(button);
    });
    var selective = document.getElementById("selective-controls");
    slider(selective, "Hue", "selective.ACTIVE.hue", -100, 100, 0);
    slider(selective, "Saturation", "selective.ACTIVE.saturation", -100, 100, 0);
    slider(selective, "Luminance", "selective.ACTIVE.luminance", -100, 100, 0);

    var levels = document.getElementById("levels-controls");
    slider(levels, "Input Black", "levels.inputBlack", 0, 100, 0);
    slider(levels, "Midtone", "levels.midtone", 0, 100, 50);
    slider(levels, "Input White", "levels.inputWhite", 0, 100, 100);
    slider(levels, "Output Black", "levels.outputBlack", 0, 100, 0);
    slider(levels, "Output White", "levels.outputWhite", 0, 100, 100);

    slider(document.getElementById("black-white-controls"), "Strength", "blackAndWhite", 0, 100, 0);

    var color = document.getElementById("color-controls");
    slider(color, "Saturation", "saturation", -100, 100, 0);
    slider(color, "Vibrance", "vibrance", -100, 100, 0);

    var light = document.getElementById("light-controls");
    [["Brilliance", "brilliance"], ["Exposure", "exposure"], ["Highlights", "highlights"],
     ["Shadows", "shadows"], ["Brightness", "brightness"], ["Contrast", "contrast"],
     ["Black Point", "blackPoint"]].forEach(function (pair) {
      slider(light, pair[0], pair[1], -100, 100, 0);
    });

    var filterButtons = document.getElementById("filter-buttons");
    FILTERS.forEach(function (name) {
      var button = document.createElement("button");
      button.type = "button";
      button.textContent = name;
      button.dataset.filter = name;
      button.setAttribute("aria-pressed", name === "Original" ? "true" : "false");
      button.addEventListener("click", function () {
        current().filter = name;
        filterButtons.querySelectorAll("button").forEach(function (b) {
          b.setAttribute("aria-pressed", b === button ? "true" : "false");
        });
        scheduleRender();
      });
      filterButtons.append(button);
    });
    slider(document.getElementById("filter-controls"), "Strength", "filterStrength", 0, 100, 100);
  }

  // ---------- calques de texte ----------

  var layerReadouts = [];

  function refreshLayerReadouts() {
    layerReadouts.forEach(function (entry) {
      var layer = currentLayers()[entry.index];
      if (!layer) return;
      var adjusted = layer.effectiveSizePx !== layer.sizePx;
      entry.node.textContent = adjusted
        ? ("affiché " + layer.effectiveSizePx + "px (ajusté pour tenir dans le cadre)")
        : "";
      entry.node.classList.toggle("adjusted", adjusted);
    });
  }

  function buildLayerPanel() {
    layerList.innerHTML = "";
    layerReadouts = [];
    currentLayers().forEach(function (layer, index) {
      var block = document.createElement("div");
      block.className = "layer-block";

      var head = document.createElement("div");
      head.className = "layer-head";
      var idx = document.createElement("span");
      idx.className = "idx";
      idx.textContent = "T" + (index + 1);
      var title = document.createElement("span");
      title.textContent = "Calque de texte";
      var remove = document.createElement("button");
      remove.type = "button";
      remove.textContent = "Supprimer";
      remove.addEventListener("click", function () {
        currentLayers().splice(index, 1);
        buildLayerPanel();
        scheduleRender();
      });
      head.append(idx, title, remove);
      block.append(head);

      var input = document.createElement("input");
      input.type = "text";
      input.placeholder = "Texte à poser sur la photo…";
      input.value = layer.value;
      input.addEventListener("input", function () {
        layer.value = input.value;
        scheduleRender();
      });
      block.append(input);

      var row2 = document.createElement("div");
      row2.className = "row2";
      var fontSelect = document.createElement("select");
      [["serif", "Serif"], ["sans", "Sans"]].forEach(function (pair) {
        var o = document.createElement("option");
        o.value = pair[0]; o.textContent = pair[1];
        fontSelect.append(o);
      });
      fontSelect.value = layer.font;
      fontSelect.addEventListener("change", function () {
        layer.font = fontSelect.value;
        scheduleRender();
      });
      var weightSelect = document.createElement("select");
      WEIGHTS.forEach(function (pair) {
        var o = document.createElement("option");
        o.value = pair[0]; o.textContent = pair[1];
        weightSelect.append(o);
      });
      weightSelect.value = String(layer.weight);
      weightSelect.addEventListener("change", function () {
        layer.weight = parseInt(weightSelect.value, 10);
        scheduleRender();
      });
      row2.append(fontSelect, weightSelect);
      block.append(row2);

      var sizeRow = document.createElement("div");
      sizeRow.className = "size-row";
      var sizeInput = document.createElement("input");
      sizeInput.type = "number";
      sizeInput.min = String(MIN_SIZE_PX);
      sizeInput.max = "4000";
      sizeInput.step = "2";
      sizeInput.value = String(layer.sizePx);
      sizeInput.addEventListener("input", function () {
        var v = parseFloat(sizeInput.value);
        if (!isFinite(v) || v <= 0) return;
        layer.sizePx = v;
        scheduleRender();
      });
      var unit = document.createElement("span");
      unit.textContent = "px";
      unit.style.color = "var(--muted)";
      unit.style.fontSize = "11px";
      var effective = document.createElement("span");
      effective.className = "size-effective";
      layerReadouts.push({ index: index, node: effective });
      sizeRow.append(sizeInput, unit, effective);
      block.append(sizeRow);

      var bottom = document.createElement("div");
      bottom.className = "bottom";

      var swatches = document.createElement("div");
      swatches.className = "swatches";
      var yellow = document.createElement("div");
      yellow.className = "swatch yellow" + (layer.color === "#f6cf47" ? " active" : "");
      yellow.title = "Jaune #f6cf47";
      var white = document.createElement("div");
      white.className = "swatch white" + (layer.color === "#ffffff" ? " active" : "");
      white.title = "Blanc #ffffff";
      yellow.addEventListener("click", function () {
        layer.color = "#f6cf47";
        yellow.classList.add("active"); white.classList.remove("active");
        scheduleRender();
      });
      white.addEventListener("click", function () {
        layer.color = "#ffffff";
        white.classList.add("active"); yellow.classList.remove("active");
        scheduleRender();
      });
      swatches.append(yellow, white);

      var widget = document.createElement("div");
      widget.className = "anchor-widget";
      widget.dataset.mode = isLandscape() ? "9" : "3";
      var buttons = ANCHORS.map(function (anchor) {
        var b = document.createElement("button");
        b.type = "button";
        b.dataset.anchor = anchor;
        b.title = anchor;
        if (anchor === layer.anchor) b.classList.add("active");
        b.addEventListener("click", function () {
          layer.anchor = anchor;
          buttons.forEach(function (other) {
            other.classList.toggle("active", other.dataset.anchor === anchor);
          });
          scheduleRender();
        });
        widget.append(b);
        return b;
      });
      // Un format portrait ou carre n'expose que la colonne du centre : une ancre
      // laterale devenue invalide est ramenee sur son equivalent centre.
      if (!isLandscape() && layer.anchor.indexOf("-center") === -1) {
        layer.anchor = clampAnchorToCenter(layer.anchor);
        buttons.forEach(function (b) {
          b.classList.toggle("active", b.dataset.anchor === layer.anchor);
        });
      }

      bottom.append(swatches, widget);
      block.append(bottom);
      layerList.append(block);
    });

    addLayerBtn.disabled = currentLayers().length >= MAX_LAYERS;
    addLayerBtn.textContent = currentLayers().length >= MAX_LAYERS
      ? "+ Ajouter un texte (3 maximum)"
      : "+ Ajouter un texte";
    refreshLayerReadouts();
  }

  addLayerBtn.addEventListener("click", function () {
    if (currentLayers().length >= MAX_LAYERS) return;
    currentLayers().push(newLayer(currentLayers().length));
    buildLayerPanel();
    scheduleRender();
  });

  // ---------- bande de vignettes, selection et reorder ----------

  var dragSrcId = null;

  function refreshTileFlags() {
    strip.querySelectorAll(".tile").forEach(function (tile) {
      tile.classList.toggle("has-edits", hasEdits(tile.dataset.id));
      tile.classList.toggle("selected", tile.dataset.id === selectedId);
    });
  }

  function renderStrip() {
    strip.innerHTML = "";
    order.forEach(function (id, index) {
      var img = byId[id];
      var tile = document.createElement("div");
      tile.className = "tile";
      tile.draggable = true;
      tile.dataset.id = id;

      var thumb = document.createElement("div");
      thumb.className = "thumb";
      var el = document.createElement("img");
      el.src = srcUrl(img.file, img.sourceId || img.id);
      el.alt = img.file;
      thumb.append(el);

      var meta = document.createElement("div");
      meta.className = "meta";
      var pos = document.createElement("span");
      pos.className = "pos";
      pos.textContent = String(index + 1).padStart(2, "0");
      var nm = document.createElement("span");
      nm.className = "nm";
      nm.textContent = img.variant || img.file;
      meta.append(pos, nm);

      var dot = document.createElement("span");
      dot.className = "edited";

      tile.append(thumb, meta, dot);
      tile.classList.toggle("variation", isVariation(id));

      tile.addEventListener("click", function () { select(id); });
      tile.addEventListener("dragstart", function () { dragSrcId = id; tile.classList.add("dragging"); });
      tile.addEventListener("dragend", function () { tile.classList.remove("dragging"); });
      tile.addEventListener("dragover", function (e) { e.preventDefault(); tile.classList.add("drop-target"); });
      tile.addEventListener("dragleave", function () { tile.classList.remove("drop-target"); });
      tile.addEventListener("drop", function (e) {
        e.preventDefault();
        tile.classList.remove("drop-target");
        if (!dragSrcId || dragSrcId === id) return;
        var from = order.indexOf(dragSrcId);
        var to = order.indexOf(id);
        order.splice(from, 1);
        order.splice(to, 0, dragSrcId);
        dragSrcId = null;
        renderStrip();
        updateCurrentLabel();
      });

      strip.append(tile);
    });
    refreshTileFlags();
  }

  function updateCurrentLabel() {
    var img = byId[selectedId];
    currentLabel.innerHTML = "position <b>" + String(order.indexOf(selectedId) + 1).padStart(2, "0") +
      "</b> · id " + selectedId + " · " + (img.variant || img.file);
    document.getElementById("deleteVariationBtn").disabled = !isVariation(selectedId);
  }

  function select(id) {
    selectedId = id;
    updateCurrentLabel();
    source.src = srcUrl(byId[id].file, byId[id].sourceId || id);
    refreshTileFlags();
    syncPhotoControls();
    buildLayerPanel();
    // Deux variantes peuvent partager la meme data URI. Dans ce cas, le
    // navigateur peut ne pas relancer `load`, donc le rendu doit aussi etre
    // programme ici pour afficher immediatement les reglages de la variante.
    scheduleRender();
  }

  source.addEventListener("load", function () {
    var cropped = buildCrop();
    processor.setImage(cropped || source);
    processor.set(current());
    var p = previewSize();
    frame.style.setProperty("--img-ratio", p.w + " / " + p.h);
    status.textContent = source.naturalWidth + " × " + source.naturalHeight + " px";
    buildLayerPanel();
    renderTextLayers();
  });
  source.addEventListener("error", function () {
    status.textContent = "image introuvable : " + source.src;
  });

  // ---------- actions ----------

  document.getElementById("applyAllBtn").addEventListener("click", function () {
    applyEverythingToAll();
    flash(document.getElementById("applyAllBtn"));
  });

  function duplicateSelected() {
    var original = byId[selectedId];
    var sourceId = original.sourceId || original.id;
    var number = 2;
    var duplicateId = sourceId + "-v" + number;
    while (byId[duplicateId]) duplicateId = sourceId + "-v" + (++number);
    var duplicate = {
      id: duplicateId,
      sourceId: sourceId,
      file: original.file,
      w: original.w,
      h: original.h,
      variant: original.file + " · variation " + number
    };
    byId[duplicateId] = duplicate;
    settings[duplicateId] = JSON.parse(JSON.stringify(settings[selectedId]));
    layers[duplicateId] = JSON.parse(JSON.stringify(layers[selectedId]));
    crops[duplicateId] = JSON.parse(JSON.stringify(crops[selectedId]));
    order.splice(order.indexOf(selectedId) + 1, 0, duplicateId);
    updateCountLabel();
    renderStrip();
    select(duplicateId);
  }

  function deleteSelectedVariation() {
    if (!isVariation(selectedId)) return;
    var removedAt = order.indexOf(selectedId);
    var removedId = selectedId;
    order.splice(removedAt, 1);
    delete byId[removedId];
    delete settings[removedId];
    delete layers[removedId];
    delete crops[removedId];
    selectedId = order[Math.max(0, removedAt - 1)];
    updateCountLabel();
    renderStrip();
    select(selectedId);
  }

  document.getElementById("duplicateImageBtn").addEventListener("click", duplicateSelected);
  document.getElementById("deleteVariationBtn").addEventListener("click", deleteSelectedVariation);

  document.getElementById("resetImageBtn").addEventListener("click", function () {
    settings[selectedId] = ZRPhotoAdjustments.defaults();
    layers[selectedId] = [];
    crops[selectedId] = { zoom: 1, px: 50, py: 50, rotate: 0 };
    syncPhotoControls();
    syncPhotoControls();
    buildLayerPanel();
    scheduleRender();
  });

  document.getElementById("resetOrderBtn").addEventListener("click", function () {
    var variations = order.filter(function (id) { return isVariation(id); });
    order = initialOrder.slice().concat(variations);
    renderStrip();
    updateCurrentLabel();
  });

  function payload() {
    var images = {};
    order.forEach(function (id, index) {
      var img = byId[id];
      images[id] = {
        position: index + 1,
        source_id: img.sourceId || img.id,
        file: img.file,
        variation: img.variant || null,
        output: String(index + 1).padStart(2, "0") + ".jpg",
        crop: crops[id],
        photo: settings[id],
        text: layers[id]
          .filter(function (l) { return l.value.trim(); })
          .map(function (l) {
            return {
              value: l.value.trim(), font: l.font, weight: l.weight,
              size_px: l.effectiveSizePx, requested_size_px: l.sizePx,
              color: l.color, anchor: l.anchor
            };
          })
      };
    });
    var fmt = FORMATS[state.format];
    return {
      project: PROJECT,
      format: fmt ? { key: state.format, w: fmt.w, h: fmt.h, factor: fmt.factor } : null,
      order: order,
      images: images
    };
  }

  function copyText(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) {}
    ta.remove();
    return ok;
  }

  function outputText() {
    var data = payload();
    var f = data.format;
    var head = "ZENRAY-HTML-HDA STUDIO · " + PROJECT + " · " +
      (f ? "format " + f.key + "(" + f.w + "x" + f.h + ") ×" + f.factor +
           " → " + (f.w * f.factor) + "x" + (f.h * f.factor)
         : "format d'origine conservé");
    var lines = order.map(function (id) {
      var entry = data.images[id];
      var c = entry.crop;
      var marks = [];
      if (!isNeutralPhoto(entry.photo)) marks.push("photo retouchée");
      if (entry.text.length) marks.push(entry.text.length + " texte" + (entry.text.length > 1 ? "s" : ""));
      return String(entry.position).padStart(2, "0") + ": " + (entry.variation || entry.file) + " -> " + entry.output +
        "  zoom=" + Number(c.zoom).toFixed(2) + " rotate=" + Number(c.rotate).toFixed(1) + "deg" +
        " x=" + Math.round(c.px) + "% y=" + Math.round(c.py) + "%" +
        (marks.length ? "  (" + marks.join(", ") + ")" : "");
    });
    return head + "\n\n" + lines.join("\n") + "\n\n" + JSON.stringify(data, null, 2);
  }

  var outBox = document.getElementById("outBox");
  var outText = document.getElementById("outText");

  document.getElementById("copyAllBtn").addEventListener("click", function () {
    var text = outputText();
    outText.value = text;
    outBox.classList.add("shown");
    outText.focus();
    outText.select();
    copyText(text);
  });
  document.getElementById("outCopyBtn").addEventListener("click", function () {
    var ok = copyText(outText.value);
    document.getElementById("outCopyBtn").textContent = ok ? "Copié" : "Sélectionne et copie à la main";
  });
  document.getElementById("outCloseBtn").addEventListener("click", function () {
    outBox.classList.remove("shown");
    document.getElementById("outCopyBtn").textContent = "Copier";
  });

  // ---------- demarrage ----------

  var fmtSelect = document.getElementById("fmtSelect");
  Object.keys(FORMATS).forEach(function (key) {
    var opt = document.createElement("option");
    opt.value = key;
    opt.textContent = key === "source" ? "source (sans recadrage)" : key;
    if (key === state.format) opt.selected = true;
    fmtSelect.appendChild(opt);
  });
  function applyFormat() {
    var fmt = FORMATS[state.format];
    var out = outputSize();
    document.getElementById("resLabel").textContent = fmt
      ? fmt.w + "×" + fmt.h + " ×" + fmt.factor + " → sortie " + out.w + "×" + out.h
      : "format d'origine conservé";
    var p = previewSize();
    frame.style.setProperty("--img-ratio", p.w + " / " + p.h);
    // Une ancre laterale n'a de sens qu'en format horizontal.
    order.forEach(function (id) {
      layers[id].forEach(function (l) {
        if (!isLandscape() && l.anchor.indexOf("-center") === -1) l.anchor = clampAnchorToCenter(l.anchor);
      });
    });
    buildLayerPanel();
    scheduleRender();
  }
  fmtSelect.addEventListener("change", function () {
    state.format = fmtSelect.value;
    applyFormat();
  });

  buildPhotoControls();
  renderStrip();
  select(order[0]);
  applyFormat();
})();
</script>

</body>
</html>
