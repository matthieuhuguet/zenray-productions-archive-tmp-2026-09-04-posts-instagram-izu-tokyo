<style>
  /* Sept graisses reelles AnthropicSerif, une seule famille CSS : le navigateur
     choisit le fichier via font-weight. InterVariable couvre nativement 100-900. */
  @font-face { font-family: AnthropicSerif; font-weight: 300; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 400; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 500; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Medium.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 600; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 700; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Bold.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 800; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-ExtraBold.ttf"); }
  @font-face { font-family: AnthropicSerif; font-weight: 900; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Black.ttf"); }
