  function toCqw(px, cw) { return (px / cw * 100) + "cqw"; }

  // Ombre portee sophistiquee, sans reglage d'angle : Distance decale toujours
  // vers le bas. Spread (%) reprend le comportement Photoshop, du flou pur (0)
  // au tampon net (100), en tamponnant le texte sur un cercle de rayon
  // `size*spread/100` puis en floutant par le reste (`size*(1-spread/100)`) —
  // le meme algorithme que le cook Python, pour que l'apercu ne mente jamais.
  function buildTextShadow(layer, cw) {
    var s = layer.shadow;
    if (!s || !s.enabled) return "none";
    var size = Math.max(0, s.size || 0);
    var spreadPct = Math.max(0, Math.min(100, s.spread || 0));
    var spreadPx = size * (spreadPct / 100);
    var blurPx = size * (1 - spreadPct / 100);
    var distancePx = s.distance || 0;
    var color = "rgba(0,0,0,.65)";
    var points = spreadPx > 0.05 ? 12 : 1;
    var parts = [];
    for (var i = 0; i < points; i++) {
      var angle = points > 1 ? (i / points) * Math.PI * 2 : 0;
      var dx = points > 1 ? spreadPx * Math.cos(angle) : 0;
      var dy = distancePx + (points > 1 ? spreadPx * Math.sin(angle) : 0);
      parts.push(toCqw(dx, cw) + " " + toCqw(dy, cw) + " " + toCqw(blurPx, cw) + " " + color);
