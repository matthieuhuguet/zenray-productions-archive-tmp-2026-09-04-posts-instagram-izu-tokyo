    var parts = state.format.split(":");
    root.style.setProperty("--fmt-ratio", parts[0] + " / " + parts[1]);
    var outW = f.w * f.factor, outH = f.h * f.factor;
    resLabel.textContent = f.w + "×" + f.h + " ×" + f.factor + " → sortie " + outW + "×" + outH;
    IMAGES.forEach(function (img) {
      if (!img._els.imgEl) return;
      img._els.imgEl.style.setProperty("--safescale", safeScale(img.rotate, f.w, f.h));
      if (img._els.setAnchorMode) img._els.setAnchorMode();
      if (img._els.refreshOverlay) img._els.refreshOverlay();
    });
  }
  fmtSelect.addEventListener("change", function () {
    state.format = fmtSelect.value;
    applyFormat();
  });

  document.title = "zenray-html-hda · " + PROJECT;
  document.getElementById("projectLabel").textContent = PROJECT;
  countLabel.textContent = IMAGES.length + " photos";

  function lineFor(img) {
    var f = FORMATS[state.format];
    var line = "[" + img.id + "] " + img.file + " · zoom=" + img.zoom.toFixed(2) +
      " rotate=" + img.rotate.toFixed(1) + "deg" +
      " grain=" + Math.round(img.grain) + "%" +
      " x=" + Math.round(img.px) + "% y=" + Math.round(img.py) + "% format=" +
      state.format + "(" + f.w + "x" + f.h + ")";
    img.textLayers.forEach(function (layer, index) {
      if (!layer.value.trim()) return;
      line += "\n    T" + (index + 1) +
        ' text="' + layer.value.trim().replace(/"/g, "'") + '"' +
        " font=" + layer.font + " weight=" + layer.weight +
        " size=" + layer.effectiveSizePx + "px" +
        " color=" + layer.color + " anchor=" + layer.anchor;
    });
    return line;
  }

  function copyText(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) {}
    ta.remove();
    return ok;
  }

  IMAGES.forEach(function (img) {
    var card = document.createElement("div");
    card.className = "card";

    var badge = document.createElement("div");
    badge.className = "badge";
    badge.innerHTML =
      '<span class="id">' + img.id + '</span>' +
      '<span class="name">' + img.file + '</span>' +
      '<span class="dims">' + img.w + '×' + img.h + '</span>';
    card.appendChild(badge);

    var frame = document.createElement("div");
    frame.className = "crop-frame";
    var el = document.createElement("img");
    el.src = SOURCE_DIR + encodeURIComponent(img.file).replace(/%2F/g, "/");
    el.alt = img.file;
    el.style.setProperty("--zoom", img.zoom);
    el.style.setProperty("--px", img.px + "%");
    el.style.setProperty("--py", img.py + "%");
    el.style.setProperty("--angle", img.rotate + "deg");
    el.style.setProperty("--safescale", safeScale(img.rotate, FORMATS[state.format].w, FORMATS[state.format].h));
    frame.appendChild(el);
    img._els.imgEl = el;

    var grainOverlay = document.createElement("div");
    grainOverlay.className = "grain-overlay";
    frame.appendChild(grainOverlay);
    frame.style.setProperty("--grain", img.grain);
    img._els.frame = frame;

    var overlayHost = document.createElement("div");
    overlayHost.className = "text-overlays";
    frame.appendChild(overlayHost);
    img._els.overlayHost = overlayHost;

    card.appendChild(frame);

    var controls = document.createElement("div");
    controls.className = "controls";

    function sliderRow(key, labelText, min, max, step, value, decimals, onInput) {
      var row = document.createElement("div");
      row.className = "slider-row";
      var lbl = document.createElement("div");
      lbl.className = "row-label";
      var valSpan = document.createElement("b");
      valSpan.textContent = value.toFixed(decimals);
      lbl.innerHTML = "<span>" + labelText + "</span>";
      lbl.appendChild(valSpan);
      row.appendChild(lbl);
      var input = document.createElement("input");
      input.type = "range";
      input.min = min; input.max = max; input.step = step; input.value = value;

      function commit(v) {
        input.value = v;
        valSpan.textContent = Number(v).toFixed(decimals);
        onInput(Number(v));
      }
      input.addEventListener("input", function () { commit(parseFloat(input.value)); });
      row.appendChild(input);

      var extra = document.createElement("div");
      extra.className = "control-extra";
      STEP_MARKS.forEach(function (percent) {
        var mark = document.createElement("button");
        mark.type = "button";
        mark.className = "step" + (percent === 25 || percent === 75 ? " minor" : "");
        mark.textContent = percent;
        mark.title = percent + " % de la plage";
        mark.addEventListener("click", function () { commit(steppedValue(min, max, percent)); });
        extra.appendChild(mark);
      });
      var toAll = document.createElement("button");
      toAll.type = "button";
      toAll.className = "apply-all";
      toAll.textContent = "à toutes";
      toAll.title = "Appliquer CE réglage à toutes les photos, maintenant. Les images restent indépendantes ensuite.";
      toAll.addEventListener("click", function () {
        applyKeyToAll(key, parseFloat(input.value));
        flash(toAll);
      });
      extra.appendChild(toAll);
      row.appendChild(extra);

      registerControl(key, commit);
      return row;
    }

    controls.appendChild(sliderRow("zoom", "Zoom", 1, 3, 0.01, img.zoom, 2, function (v) {
      img.zoom = v; el.style.setProperty("--zoom", v);
    }));
    controls.appendChild(sliderRow("px", "Position X", 0, 100, 1, img.px, 0, function (v) {
      img.px = v; el.style.setProperty("--px", v + "%");
    }));
    controls.appendChild(sliderRow("py", "Position Y", 0, 100, 1, img.py, 0, function (v) {
      img.py = v; el.style.setProperty("--py", v + "%");
    }));
    controls.appendChild(sliderRow("rotate", "Rotation °", -45, 45, 0.5, img.rotate, 1, function (v) {
      img.rotate = v;
      el.style.setProperty("--angle", v + "deg");
      el.style.setProperty("--safescale", safeScale(v, FORMATS[state.format].w, FORMATS[state.format].h));
    }));
    controls.appendChild(sliderRow("grain", "Grain", 0, 100, 1, img.grain, 0, function (v) {
      img.grain = v; frame.style.setProperty("--grain", v);
    }));

    // Copie INTEGRALE de cette carte vers toutes les autres : cadrage et
    // calques de texte. Copie profonde, jamais une reference partagee, donc
    // chaque image reste modifiable seule apres le clic.
    var applyEverything = document.createElement("button");
    applyEverything.type = "button";
    applyEverything.className = "apply-everything";
    applyEverything.textContent = "Appliquer TOUT ce réglage à toutes";
    applyEverything.title = "Cadrage et textes de cette photo recopiés sur toutes, maintenant. Les images restent indépendantes ensuite.";
    applyEverything.addEventListener("click", function () {
      var textCopy = JSON.parse(JSON.stringify(img.textLayers));
      IMAGES.forEach(function (other) {
        if (other.id === img.id) return;
        other.zoom = img.zoom; other.px = img.px; other.py = img.py; other.rotate = img.rotate; other.grain = img.grain;
        other.textLayers = JSON.parse(JSON.stringify(textCopy));
        if (other._els.imgEl) {
          other._els.imgEl.style.setProperty("--zoom", other.zoom);
          other._els.imgEl.style.setProperty("--px", other.px + "%");
          other._els.imgEl.style.setProperty("--py", other.py + "%");
          other._els.imgEl.style.setProperty("--angle", other.rotate + "deg");
          other._els.imgEl.style.setProperty("--safescale",
            safeScale(other.rotate, FORMATS[state.format].w, FORMATS[state.format].h));
        }
        if (other._els.frame) other._els.frame.style.setProperty("--grain", other.grain);
        if (other._els.rebuildLayers) other._els.rebuildLayers();
        if (other._els.refreshOverlay) other._els.refreshOverlay();
      });
      // Les curseurs des autres cartes doivent afficher la nouvelle valeur.
      applyKeyToAll("zoom", img.zoom); applyKeyToAll("px", img.px);
      applyKeyToAll("py", img.py); applyKeyToAll("rotate", img.rotate); applyKeyToAll("grain", img.grain);
      flash(applyEverything);
    });
    controls.appendChild(applyEverything);

    // Calques de texte, aucun par defaut, jusqu'a trois par image (2026-09-01).
    var layerList = document.createElement("div");
    layerList.className = "layer-list";
    controls.appendChild(layerList);

    var addLayerBtn = document.createElement("button");
    addLayerBtn.type = "button";
    addLayerBtn.className = "add-layer";
    controls.appendChild(addLayerBtn);

    var layerReadouts = [];

    function refreshOverlay() {
      // Redessine TOUS les calques de l'image, et met a jour les mentions de
      // taille ajustee. La taille demandee reste un point de depart : c'est la
      // taille effective, celle qui tient dans le cadre, qui est affichee et
      // copiee.
      var canvas = canvasSize();
      overlayHost.innerHTML = "";
      img.textLayers.forEach(function (layer) {
        var effective = layer.value
          ? fitTextSize(layer.value, layer.font, layer.weight, layer.anchor, layer.sizePx, canvas.w, canvas.h)
          : layer.sizePx;
        layer.effectiveSizePx = effective;
        if (!layer.value.trim()) return;
        var parts = layer.anchor.split("-");
        var el = document.createElement("div");
        el.className = "text-overlay shown font-" + layer.font +
          " anchor-v-" + parts[0] + " anchor-h-" + parts[1];
        el.style.color = layer.color;
        el.style.fontWeight = layer.weight;
        el.style.fontSize = (effective / canvas.w * 100) + "cqw";
        el.textContent = layer.value;
        overlayHost.appendChild(el);
      });
      layerReadouts.forEach(function (entry) {
        var layer = img.textLayers[entry.index];
        if (!layer) return;
        var adjusted = layer.effectiveSizePx !== layer.sizePx;
        entry.node.textContent = adjusted
          ? ("affiché " + layer.effectiveSizePx + "px (ajusté pour tenir dans le cadre)")
          : "";
        entry.node.classList.toggle("adjusted", adjusted);
      });
    }

    function buildLayerPanel() {
      layerList.innerHTML = "";
      layerReadouts = [];
      img.textLayers.forEach(function (layer, index) {
        var block = document.createElement("div");
        block.className = "layer-block";

        var head = document.createElement("div");
        head.className = "layer-head";
        var idx = document.createElement("span");
        idx.className = "idx";
        idx.textContent = "T" + (index + 1);
        var title = document.createElement("span");
        title.textContent = "Texte";
        var remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "Supprimer";
        remove.addEventListener("click", function () {
          img.textLayers.splice(index, 1);
          buildLayerPanel();
          refreshOverlay();
        });
        head.appendChild(idx); head.appendChild(title); head.appendChild(remove);
        block.appendChild(head);

        var textInput = document.createElement("input");
        textInput.type = "text";
        textInput.placeholder = "Texte à poser sur la photo…";
        textInput.value = layer.value;
        textInput.addEventListener("input", function () {
          layer.value = textInput.value; refreshOverlay();
        });
        block.appendChild(textInput);

        var row2 = document.createElement("div");
        row2.className = "row2";
        var fontSelect = document.createElement("select");
        ["serif", "sans"].forEach(function (v) {
          var o = document.createElement("option"); o.value = v;
          o.textContent = v === "serif" ? "Serif" : "Sans";
          fontSelect.appendChild(o);
        });
        fontSelect.value = layer.font;
        fontSelect.addEventListener("change", function () {
          layer.font = fontSelect.value; refreshOverlay();
        });
        var weightSelect = document.createElement("select");
        WEIGHTS.forEach(function (w) {
          var o = document.createElement("option"); o.value = w[0]; o.textContent = w[1];
          weightSelect.appendChild(o);
        });
        weightSelect.value = String(layer.weight);
        weightSelect.addEventListener("change", function () {
          layer.weight = parseInt(weightSelect.value, 10); refreshOverlay();
        });
        row2.appendChild(fontSelect); row2.appendChild(weightSelect);
        block.appendChild(row2);

        var sizeRow = document.createElement("div");
        sizeRow.className = "size-row";
        var sizeInput = document.createElement("input");
        sizeInput.type = "number";
        sizeInput.min = String(MIN_SIZE_PX);
        sizeInput.max = "4000";
        sizeInput.step = "2";
        sizeInput.value = String(layer.sizePx);
        sizeInput.addEventListener("input", function () {
          var v = parseFloat(sizeInput.value);
          if (!isFinite(v) || v <= 0) return;
          layer.sizePx = v; refreshOverlay();
        });
        var sizeUnit = document.createElement("span");
        sizeUnit.textContent = "px";
        sizeUnit.style.color = "var(--muted)";
        sizeUnit.style.fontSize = "11px";
        var sizeEffective = document.createElement("span");
        sizeEffective.className = "size-effective";
        layerReadouts.push({ index: index, node: sizeEffective });
        sizeRow.appendChild(sizeInput); sizeRow.appendChild(sizeUnit); sizeRow.appendChild(sizeEffective);
        block.appendChild(sizeRow);

        var swatches = document.createElement("div");
        swatches.className = "swatches";
        var yellowSwatch = document.createElement("div");
        yellowSwatch.className = "swatch yellow" + (layer.color === "#f6cf47" ? " active" : "");
        yellowSwatch.title = "Jaune #f6cf47";
        var whiteSwatch = document.createElement("div");
        whiteSwatch.className = "swatch white" + (layer.color === "#ffffff" ? " active" : "");
        whiteSwatch.title = "Blanc #ffffff";
        yellowSwatch.addEventListener("click", function () {
          layer.color = "#f6cf47";
          yellowSwatch.classList.add("active"); whiteSwatch.classList.remove("active");
          refreshOverlay();
        });
        whiteSwatch.addEventListener("click", function () {
          layer.color = "#ffffff";
          whiteSwatch.classList.add("active"); yellowSwatch.classList.remove("active");
          refreshOverlay();
        });
        swatches.appendChild(yellowSwatch); swatches.appendChild(whiteSwatch);
        block.appendChild(swatches);

        var anchorBlock = document.createElement("div");
        anchorBlock.className = "anchor-block";
        var anchorLabel = document.createElement("div");
        anchorLabel.className = "anchor-label";
        anchorLabel.textContent = "Position";
        anchorBlock.appendChild(anchorLabel);
        var anchorWidget = document.createElement("div");
        anchorWidget.className = "anchor-widget";
        anchorWidget.dataset.mode = isLandscapeFormat(state.format) ? "9" : "3";
        var anchorButtons = ANCHORS.map(function (a) {
          var b = document.createElement("button");
          b.type = "button";
          b.dataset.anchor = a;
          b.title = a;
          if (a === layer.anchor) b.classList.add("active");
          b.addEventListener("click", function () {
            layer.anchor = a;
            anchorButtons.forEach(function (btn) {
              btn.classList.toggle("active", btn.dataset.anchor === a);
            });
            refreshOverlay();
          });
          anchorWidget.appendChild(b);
          return b;
        });
        anchorBlock.appendChild(anchorWidget);
        block.appendChild(anchorBlock);

        layerList.appendChild(block);
      });

      addLayerBtn.disabled = img.textLayers.length >= MAX_LAYERS;
      addLayerBtn.textContent = img.textLayers.length >= MAX_LAYERS
        ? "+ Ajouter un texte (3 maximum)"
        : "+ Ajouter un texte";
    }

    addLayerBtn.addEventListener("click", function () {
      if (img.textLayers.length >= MAX_LAYERS) return;
      img.textLayers.push(newLayer(img.textLayers.length));
      buildLayerPanel();
      refreshOverlay();
    });

    // Un format portrait ou carre n'expose que la colonne du centre : au
    // changement de format, une ancre laterale devenue invalide est ramenee sur
    // son equivalent centre, sur TOUS les calques.
    function setAnchorMode() {
      var landscape = isLandscapeFormat(state.format);
      var changed = false;
      img.textLayers.forEach(function (layer) {
        if (!landscape && layer.anchor.indexOf("-center") === -1) {
          layer.anchor = clampAnchorToCenter(layer.anchor);
          changed = true;
        }
      });
      layerList.querySelectorAll(".anchor-widget").forEach(function (widget) {
        widget.dataset.mode = landscape ? "9" : "3";
      });
      if (changed) buildLayerPanel();
    }
    img._els.setAnchorMode = setAnchorMode;

    // Pas d'appel de refreshOverlay ici : le cadre n'est pas encore attache au
    // DOM, donc clientWidth vaudrait 0. Le premier rendu part du applyFormat()
    // final, une fois toutes les cartes posees dans la page.
    img._els.refreshOverlay = refreshOverlay;
    img._els.rebuildLayers = buildLayerPanel;

    buildLayerPanel();

    var actions = document.createElement("div");
    actions.className = "card-actions";
    var copyBtn = document.createElement("button");
    copyBtn.className = "copy";
    copyBtn.textContent = "Copier les paramètres";
    var echo = document.createElement("span");
    echo.className = "copy-echo";
    echo.textContent = "id " + img.id + " · " + img.file;
    copyBtn.addEventListener("click", function () {
      var line = lineFor(img);
      var ok = copyText(line);
      echo.textContent = (ok ? "copié : " : "à copier à la main : ") + line;
      echo.className = "copy-echo done";
    });
    actions.appendChild(copyBtn);
    actions.appendChild(echo);
    controls.appendChild(actions);

    card.appendChild(controls);
    grid.appendChild(card);
  });

  document.getElementById("copyAllBtn").addEventListener("click", function () {
    var f = FORMATS[state.format];
    var header = "CADRAGE ZENRAY-HTML-HDA · " + PROJECT + " · format " + state.format +
      "(" + f.w + "x" + f.h + ") ×" + f.factor + " → " + (f.w * f.factor) + "x" + (f.h * f.factor);
    var lines = IMAGES.map(lineFor);
    var text = header + "\n\n" + lines.join("\n");
    var ok = copyText(text);
    var box = document.getElementById("batchOut");
    var area = document.getElementById("batchText");
    area.value = (ok ? "copié dans le presse-papier :\n\n" : "copie refusée, sélectionne à la main :\n\n") + text;
    box.classList.add("shown");
  });

  applyFormat();
})();
</script>

</body>
</html>
